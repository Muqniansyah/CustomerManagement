<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="191.0" prefWidth="371.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.customermanagement.controller.LoginController">
    <stylesheets>
        <URL value="@/styles/login.css" />
    </stylesheets>
   <children>
      <VBox alignment="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="170.0" prefWidth="345.0" spacing="10.0">
         <children>
            <Label alignment="TOP_CENTER" text="Customer Mangement System" textAlignment="CENTER" />
            <TextField fx:id="usernameField" alignment="CENTER" maxWidth="250.0" prefHeight="25.0" prefWidth="419.0" promptText="Username" />
            <PasswordField fx:id="passwordField" alignment="CENTER" maxWidth="250.0" prefHeight="25.0" prefWidth="89.0" promptText="password" />
            <Button fx:id="loginButton" alignment="CENTER" mnemonicParsing="false" onAction="#handleLogin" text="Login" textAlignment="CENTER" />
            <Label fx:id="errorLabel" />
         </children>
      </VBox>
   </children>
</AnchorPane>
