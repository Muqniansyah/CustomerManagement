<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- styling dengan cara styleclass -->

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="900.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.customermanagement.controller.CustomerFormController">
    <stylesheets>
        <URL value="@/styles/customer-form.css" />
    </stylesheets>
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- maxHeight="-Infinity" & usePrefHeight agar kartu TIDAK ditarik melar vertikal oleh StackPane -->
            <!-- maxWidth dinaikkan ke 480px agar bentuknya proporsional seperti login card -->
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="480.0" prefWidth="480.0" spacing="12.0" styleClass="card" StackPane.alignment="CENTER">
               <padding>
                  <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
               </padding>
               <children>
                  <Label styleClass="form-title" text="Form Data Pelanggan" />

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Nama" />
                              <TextField fx:id="nameField" promptText="Contoh: Budi Santoso" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="nameError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Telepon" />
                              <TextField fx:id="phoneField" promptText="08xxxxxxxxxx" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="phoneError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Email" />
                              <TextField fx:id="emailField" promptText="nama@email.com" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="emailError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="80.0" styleClass="form-label" text="Alamat" />
                        <TextField fx:id="addressField" promptText="Alamat lengkap (ops)" styleClass="text-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Kategori" />
                              <ComboBox fx:id="categoryField" maxWidth="1.7976931348623157E308" promptText="Pilih kategori" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="categoryError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Status" />
                              <ComboBox fx:id="statusField" maxWidth="1.7976931348623157E308" promptText="Pilih status" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="statusError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <!-- Lebar disamakan 80.0 agar sejajar dan tulisan Catatan tidak terpotong lagi -->
                        <Label prefWidth="80.0" styleClass="form-label" text="Catatan" />
                        <TextArea fx:id="notesField" prefHeight="65.0" prefWidth="325.0" promptText="Catatan (ops)" styleClass="text-area" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button fx:id="btnCancel" mnemonicParsing="false" styleClass="cancel-button" text="Batal" />
                        <Button fx:id="btnSave" mnemonicParsing="false" styleClass="save-button" text="Simpan" />
                     </children>
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
