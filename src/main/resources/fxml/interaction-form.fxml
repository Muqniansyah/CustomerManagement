<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Form Interaksi dengan desain yang konsisten -->
<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="900.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.customermanagement.controller.InteractionFormController">

    <stylesheets>
        <URL value="@/styles/interaction-form.css" />
    </stylesheets>

    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- maxHeight="-Infinity" mengunci kartu agar tidak memanjang vertikal -->
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="480.0" prefWidth="480.0" spacing="12.0" styleClass="card" StackPane.alignment="CENTER">
                    
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                    </padding>

                    <children>
                        <Label styleClass="form-title" text="Form Interaksi" />

                        <VBox spacing="3.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label prefWidth="80.0" styleClass="form-label" text="Pelanggan" />
                                    <ComboBox fx:id="customerField" maxWidth="1.7976931348623157E308" promptText="Pilih pelanggan" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Label fx:id="customerError" managed="false" styleClass="field-error" visible="false" />
                           </children>
                        </VBox>

                        <VBox spacing="3.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label prefWidth="80.0" styleClass="form-label" text="Tanggal" />
                                    <DatePicker fx:id="dateField" maxWidth="1.7976931348623157E308" promptText="Pilih tanggal" styleClass="date-picker" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Label fx:id="dateError" managed="false" styleClass="field-error" visible="false" />
                           </children>
                        </VBox>

                        <VBox spacing="3.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label prefWidth="80.0" styleClass="form-label" text="Tipe" />
                                    <ComboBox fx:id="typeField" maxWidth="1.7976931348623157E308" promptText="Pilih tipe" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Label fx:id="typeError" managed="false" styleClass="field-error" visible="false" />
                           </children>
                        </VBox>

                        <VBox spacing="3.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label prefWidth="80.0" styleClass="form-label" text="Deskripsi" />
                                    <TextArea fx:id="descriptionField" prefHeight="65.0" prefWidth="325.0" promptText="Jelaskan interaksinya" styleClass="text-area" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Label fx:id="descriptionError" managed="false" styleClass="field-error" visible="false" />
                           </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="Catatan" />
                              <TextArea fx:id="notesField" prefHeight="65.0" prefWidth="325.0" promptText="Catatan tambahan (opsional)" styleClass="text-area" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button fx:id="btnCancel" mnemonicParsing="false" styleClass="cancel-button" text="Batal" />
                              <Button fx:id="btnSave" mnemonicParsing="false" styleClass="save-button" text="Simpan" />
                           </children>
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>