<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.mycompany.customermanagement.controller.InteractionController">
    <stylesheets>
        <URL value="@/styles/interaction-list.css" />
    </stylesheets>
   <children>
      <VBox layoutX="242.0" layoutY="84.0" prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <TableView fx:id="interactionTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colDate" prefWidth="112.0" text="Tanggal" />
                <TableColumn fx:id="colType" prefWidth="129.0" text="Tipe" />
                  <TableColumn fx:id="colDescription" prefWidth="172.0" text="Deskripsi" />
                  <TableColumn fx:id="colNotes" prefWidth="186.0" text="Catatan" />
              </columns>
            </TableView>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="btnAdd" mnemonicParsing="false" text="Tambah" />
                  <Button fx:id="btnEdit" mnemonicParsing="false" text="Edit" />
                  <Button fx:id="btnDelete" mnemonicParsing="false" text="Hapus" />
                  <Button fx:id="btnBack" mnemonicParsing="false" text="Kembali" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
