<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- styling dengan cara styleclass -->

<AnchorPane id="AnchorPane" prefHeight="543.0" prefWidth="219.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.customermanagement.controller.CustomerFormController">
    <stylesheets>
        <URL value="@/styles/customer-form.css" />
    </stylesheets>
   <children>
      <StackPane prefHeight="150.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxWidth="360.0" prefWidth="360.0" spacing="10.0" styleClass="card" StackPane.alignment="CENTER">
               <padding>
                  <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
               </padding>
               <children>
                  <Label styleClass="form-title" text="Form Data Pelanggan" />

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="70.0" styleClass="form-label" text="Nama" />
                              <TextField fx:id="nameField" promptText="Contoh: Budi Santoso" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="nameError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="70.0" styleClass="form-label" text="Telepon" />
                              <TextField fx:id="phoneField" promptText="08xxxxxxxxxx" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="phoneError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="70.0" styleClass="form-label" text="Email" />
                              <TextField fx:id="emailField" promptText="nama@email.com" styleClass="text-field" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="emailError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="70.0" styleClass="form-label" text="Alamat" />
                        <TextField fx:id="addressField" promptText="Alamat lengkap (ops)" styleClass="text-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="70.0" styleClass="form-label" text="Kategori" />
                              <ComboBox fx:id="categoryField" promptText="Pilih kategori" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="categoryError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <VBox spacing="3.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="70.0" styleClass="form-label" text="Status" />
                              <ComboBox fx:id="statusField" promptText="Pilih status" styleClass="combo-box" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="statusError" managed="false" styleClass="field-error" visible="false" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefHeight="17.0" prefWidth="41.0" styleClass="form-label" text="Catatan" />
                        <TextArea fx:id="notesField" prefHeight="55.0" prefWidth="99.0" promptText="Catatan (ops)" styleClass="text-area" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button fx:id="btnCancel" mnemonicParsing="false" styleClass="cancel-button" text="Batal" />
                        <Button fx:id="btnSave" mnemonicParsing="false" styleClass="save-button" text="Simpan" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
